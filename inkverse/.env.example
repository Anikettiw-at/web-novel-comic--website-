# Copy to .env and run:  npm run start:env
PORT=3000

# REQUIRED in production: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string

# REQUIRED in production: persistent disk locations
DATA_DIR=./data
UPLOAD_DIR=./uploads
# DB_FILE=./data/inkverse.db

# Production seeding: no demo accounts, create your real admin
SEED_DEMO=true
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=you@yourdomain.com
# ADMIN_PASSWORD=use-a-long-unique-password

# Days creator earnings are held before payout (refund/chargeback window)
HOLD_DAYS=14
